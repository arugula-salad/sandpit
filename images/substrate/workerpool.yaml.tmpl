# The WorkerPool sandpit's E2B actors run on: warm gVisor workers, each with
# room for one 2-CPU, 1 GiB sandbox (the template's size). ${WORKER_IMAGE} is the
# ateom-gvisor image of the installed Substrate (a demo pool's spec.workerImage).
apiVersion: v1
kind: Namespace
metadata:
  name: sandpit
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: sandpit-e2b
  namespace: sandpit
  labels:
    workload: sandpit-e2b
spec:
  replicas: 2
  workerImage: ${WORKER_IMAGE}
  sandboxClasses:
  - name: gvisor
  template:
    resources:
      limits: {cpu: "2", memory: 2Gi}
      requests: {cpu: 500m, memory: 2Gi}
