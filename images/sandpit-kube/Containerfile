# sandpit on Kubernetes: sandpitd (--backend substrate) and sandpit-kube, run in the cluster
# they drive. The Deployment names which (k8s/ runs sandpitd). Built from the repo root:
#   docker build -f images/sandpit-kube/Containerfile .
# by .github/workflows/substrate-images.yml, which pins the result into k8s/.
FROM docker.io/library/golang:1.27.1 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags=-s -o /out/sandpitd ./cmd/sandpitd \
 && CGO_ENABLED=0 go build -trimpath -ldflags=-s -o /out/sandpit-kube ./cmd/sandpit-kube

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/ /
USER 65532:65532
ENTRYPOINT ["/sandpitd"]
